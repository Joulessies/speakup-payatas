# SpeakUp Payatas - Environment Variables Configuration

# --- Google Maps API ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# REAL SMS GATEWAY PROVIDER CONFIGURATION (Philippines)
# ==============================================================================

# Option 1: TextBee (100% Free Android Phone Gateway - Recommended)
# Sign up at https://textbee.dev and connect your Android phone
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Option 2: Semaphore (Philippines - Globe/Smart/DITO)
# Sign up at https://semaphore.co to get your API key
# SMS_PROVIDER=semaphore
# SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Option 3: MessageBird / Bird (International)
# SMS_PROVIDER=messagebird
# MESSAGEBIRD_ACCESS_KEY=your_messagebird_access_key_here
# MESSAGEBIRD_ORIGINATOR=SpeakUp
