# SpeakUp Payatas - Environment Variables Configuration

# --- PostHog Analytics ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example

# --- Google Maps API ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Better Auth Security Configuration ---
# Direct PostgreSQL connection string from Supabase Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Generate 32+ character random secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_secret_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Sign-In ("Continue with Google" on /login) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application.
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback and https://<your-domain>/api/auth/google/callback
# The button only appears when NEXT_PUBLIC_GOOGLE_CLIENT_ID is set. Restart `npm run dev` after changing these.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# REAL SMS GATEWAY PROVIDER CONFIGURATION (Philippines)
# ==============================================================================

# Email uses Brevo. SMS uses Vonage.
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM=SPKPAYATAS
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDERNAME=SPKPAYATAS
BREVO_SENDER_NAME=SpeakUp Payatas
BREVO_SENDER_EMAIL=noreply@speakupayatas.com
BREVO_SMS_SENDER=SPKPAYATAS
BREVO_API_KEY=your_brevo_api_key
BREVO_SMTP_LOGIN=your_brevo_login_email
BREVO_SMTP_KEY=your_brevo_smtp_key

# Option 1: TextBee (Android phone gateway)
# SMS_PROVIDER=textbee
# TEXTBEE_API_KEY=your_textbee_api_key_here
# TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Option 2: Semaphore (Philippines - Globe/Smart/DITO)
# Sign up at https://semaphore.co to get your API key
# SMS_PROVIDER=semaphore
# SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Option 3: MessageBird / Bird (International)
# SMS_PROVIDER=messagebird
# MESSAGEBIRD_ACCESS_KEY=your_messagebird_access_key_here
# MESSAGEBIRD_ORIGINATOR=SpeakUp
