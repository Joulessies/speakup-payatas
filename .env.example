# SpeakUp Payatas - Environment Variables Configuration

# --- Google Maps API ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Supabase Database & Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# REAL SMS GATEWAY PROVIDER CONFIGURATION (Philippines)
# ==============================================================================

# Option 1: Semaphore (Recommended for Philippines - Globe/Smart/DITO)
# Sign up at https://semaphore.co to get your API key (includes free test credits)
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key_here

# Optional: Semaphore Custom Sender Name (leave blank if not yet approved by Semaphore)
# SEMAPHORE_SENDERNAME=SEMAPHORE

# Optional: Custom SMS Message Templates
# SMS_OTP_MESSAGE="Your SpeakUp Payatas OTP is {otp}. Valid for 5 minutes."

# Option 2: MessageBird / Bird (International)
# SMS_PROVIDER=messagebird
# MESSAGEBIRD_ACCESS_KEY=your_messagebird_access_key_here
# MESSAGEBIRD_ORIGINATOR=SpeakUp
